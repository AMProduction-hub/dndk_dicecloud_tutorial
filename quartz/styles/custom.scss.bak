@use "./variables.scss" as *;

// put your custom CSS here!

// ---------------------------------------------------------------------------
// 1. Callout fold: smooth unfold instead of the 0.1s "jump"
//    Core default: grid-template-rows 0.1s cubic-bezier(.02,.01,.47,1)
//    Verified live in public/index.css — 30-image chapters snap instead of unfold.
// ---------------------------------------------------------------------------
.callout > .callout-content {
  transition: grid-template-rows 250ms cubic-bezier(0.23, 1, 0.32, 1);
}

.callout.is-collapsed .callout-content > * {
  transition:
    height 250ms cubic-bezier(0.23, 1, 0.32, 1),
    margin 250ms cubic-bezier(0.23, 1, 0.32, 1),
    padding 250ms cubic-bezier(0.23, 1, 0.32, 1);
}

// Chevron stays fast and decoupled: it is a state indicator, the container carries the motion.
.callout-title .fold-callout-icon {
  transition: transform 120ms cubic-bezier(0.23, 1, 0.32, 1);
}

// ---------------------------------------------------------------------------
// 2. Step fold-ins ([!example]) tinted to the site accent instead of purple.
//    Three competing hues (purple steps / blue links / orange warnings) →
//    one accent hue + one alert hue.
// ---------------------------------------------------------------------------
.callout[data-callout="example"] {
  --color: var(--secondary);
  --border: color-mix(in srgb, var(--secondary) 27%, transparent);
  --bg: color-mix(in srgb, var(--secondary) 6%, transparent);
}

// ---------------------------------------------------------------------------
// 3. Pressable buttons confirm the press (darkmode, reader-mode, search, hamburger)
// ---------------------------------------------------------------------------
.darkmode,
.readermode,
button.search-button,
#explorer .explorer-toggle,
.toc-header button {
  transition: transform 160ms cubic-bezier(0.23, 1, 0.32, 1);

  &:active {
    transform: scale(0.97);
  }
}

// ---------------------------------------------------------------------------
// 4. Touch devices: kill sticky hover states (hover fires on tap otherwise)
// ---------------------------------------------------------------------------
@media (hover: none), (pointer: coarse) {
  .toc-content a:hover,
  .explorer-ul a:hover {
    text-decoration: none;
    color: inherit;
  }
}

// ---------------------------------------------------------------------------
// 5. Reduced motion: nothing ships this today (grep count in index.css: 0).
//    Keep opacity, drop all movement.
// ---------------------------------------------------------------------------
@media (prefers-reduced-motion: reduce) {
  .callout > .callout-content,
  .callout.is-collapsed .callout-content > *,
  .callout-title .fold-callout-icon,
  .darkmode,
  .readermode,
  button.search-button,
  #explorer .explorer-toggle,
  .toc-header button {
    transition-duration: 0.01ms;
  }
}
